@tempo 120

@instrument ^abc, sineOsc * adsrEnv
@effect ^e, ^*, ((a + b + c) * 3) | limit { -1, 1 }
@groove ^g, ^*, swing(384 / 4, 2 / 3)~toModuleDef()

