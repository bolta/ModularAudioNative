@let :_,
	let _ = print(null == null); // ==> true
	let _ = print(null == 0); // ==> false
	let _ = print(null == false); // ==> false
	let _ = print(null == "0"); // ==> false
	let _ = print(0 == null); // ==> false
	let _ = print("0" == null); // ==> false

	let _ = print(null != null); // ==> false
	let _ = print(null != 0); // ==> true
	let _ = print(null != false); // ==> true
	let _ = print(null != "0"); // ==> true
	let _ = print(0 != null); // ==> true
	let _ = print("0" != null); // ==> true

	let _ = print({ k: 42 }.k); // ==> 42
	// let _ = print({ k: 42 }.l); // error: EntryNotFound
	// let _ = print(null.k); // error: TypeMismatch

	let _ = print({ k: 42 }.?k); // ==> 42
	let _ = print({ k: 42 }.?l); // ==> null
	// let _ = print(null.?k); // error: TypeMismatch

	let _ = print({ k: 42 }?.k); // ==> 42
	// let _ = print({ k: 42 }?.l); // error: EntryNotFound
	let _ = print(null?.k); // ==> null

	let _ = print({ k: 42 }?.?k); // ==> 42
	let _ = print({ k: 42 }?.?l); // ==> null
	let _ = print(null?.?k); // ==> null

	null

// dummy
@instrument ^a, 0
a c4
